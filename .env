# Nginx / networking configuration
NGINX_PORT="2000"
API_PORT="8080"
API_URL="host.docker.internal"

# See https://github.com/Jacob2161/sqlitebp/blob/main/sqlitebp.go
DATA_SOURCE_NAME="sqlite:/data/sqlite.sq3?cache=private&_foreign_keys=true&_busy_timeout=10000&_journal_mode=WAL&_synchronous=NORMAL&_cache_size=-32678"
